    miniFrame.Visible = true
end)

-- Square button (munculin mini UI)
squareBtn.MouseButton1Click:Connect(function()
    _G.Settings.UIVisible = false
    _G.Settings.MiniUIVisible = true
    mainFrame.Visible = false
    miniFrame.Visible = true
end)

-- Open button di mini UI
openMiniBtn.MouseButton1Click:Connect(function()
    _G.Settings.UIVisible = true
    _G.Settings.MiniUIVisible = false
    mainFrame.Visible = true
    miniFrame.Visible = false
end)

-- Close button
closeBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = false
    miniFrame.Visible = false
    -- Hapus semua GUI
    wait(0.1)
    mainUI:Destroy()
    miniUI:Destroy()
end)

