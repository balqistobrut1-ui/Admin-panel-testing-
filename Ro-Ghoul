-- Fungsi untuk membuat section dengan toggle ON/OFF
local function CreateToggleSection(parent, title, settingKey, description)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    frame.Size = UDim2.new(1, -10, 0, 50)
    frame.BorderSizePixel = 0
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Parent = frame
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size = UDim2.new(0.7, 0, 1, 0)
    titleLabel.Position = UDim2.new(0, 10, 0, 0)
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.Gotham
    titleLabel.TextSize = 16
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Parent = frame
    toggleBtn.BackgroundColor3 = settingKey and _G.Settings[settingKey] and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(200, 60, 60)
    toggleBtn.Size = UDim2.new(0, 60, 0, 30)
    toggleBtn.Position = UDim2.new(1, -70, 0, 10)
    toggleBtn.Text = settingKey and _G.Settings[settingKey] and "ON" or "OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Font = Enum.Font.GothamBold
    toggleBtn.TextSize = 14
    toggleBtn.BorderSizePixel = 0
    
    toggleBtn.MouseButton1Click:Connect(function()
        if settingKey then
            _G.Settings[settingKey] = not _G.Settings[settingKey]
            toggleBtn.BackgroundColor3 = _G.Settings[settingKey] and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(200, 60, 60)
            toggleBtn.Text = _G.Settings[settingKey] and "ON" or "OFF"
        end
    end)
    
    return frame
end

-- Fungsi untuk membuat slider (bisa digeser di Android)
local function CreateSlider(parent, title, settingKey, min, max)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    frame.Size = UDim2.new(1, -10, 0, 70)
    frame.BorderSizePixel = 0
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Parent = frame
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size = UDim2.new(1, -20, 0, 20)
    titleLabel.Position = UDim2.new(0, 10, 0, 5)
    titleLabel.Text = title .. ": " .. tostring(_G.Settings[settingKey])
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Font = Enum.Font.Gotham
    titleLabel.TextSize = 14
    
    local sliderBg = Instance.new("Frame")
    sliderBg.Parent = frame
    sliderBg.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    sliderBg.Size = UDim2.new(1, -20, 0, 20)
    sliderBg.Position = UDim2.new(0, 10, 0, 30)
    sliderBg.BorderSizePixel = 0
    
    local sliderFill = Instance.new("Frame")
    sliderFill.Parent = sliderBg
    sliderFill.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
    sliderFill.Size = UDim2.new((_G.Settings[settingKey] - min) / (max - min), 0, 1, 0)
    sliderFill.BorderSizePixel = 0
    
    local sliderBtn = Instance.new("TextButton")
    sliderBtn.Parent = sliderBg
    sliderBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderBtn.Size = UDim2.new(0, 20, 0, 30)
    sliderBtn.Position = UDim2.new((_G.Settings[settingKey] - min) / (max - min), -10, 0, -5)
    sliderBtn.Text = ""
    sliderBtn.BorderSizePixel = 0
    sliderBtn.Active = true
    sliderBtn.Draggable = true
    
    -- Slider logic for Android (touch)
    local dragging = false
    sliderBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    
    sliderBtn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local pos = input.Position
            local absPos = sliderBg.AbsolutePosition
            local absSize = sliderBg.AbsoluteSize.X
            
            local relativeX = math.clamp((pos.X - absPos.X) / absSize, 0, 1)
            local value = math.floor(min + (relativeX * (max - min)))
            
            _G.Settings[settingKey] = value
            sliderFill.Size = UDim2.new(relativeX, 0, 1, 0)
            sliderBtn.Position = UDim2.new(relativeX, -10, 0, -5)
            titleLabel.Text = title .. ": " .. tostring(value)
        end
    end)
    
    return frame
end

-- Fungsi untuk membuat dropdown pilihan target
local function CreateDropdown(parent, title, settingKey, options)
    local frame = Instance.new("Frame")
    frame.Parent = parent
    frame.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    frame.Size = UDim2.new(1, -10, 0, 60)
    frame.BorderSizePixel = 0
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Parent = frame
    titleLabel.BackgroundTransparency = 1
    titleLabel.Size = UDim2.new(1, -20, 0, 20)
    titleLabel.Position = UDim2.new(0, 10, 0, 5)
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.Font = Enum.Font.Gotham
    titleLabel.TextSize = 14
    
    local dropdownBtn = Instance.new("TextButton")
    dropdownBtn.Parent = frame
    dropdownBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    dropdownBtn.Size = UDim2.new(1, -20, 0, 30)
    dropdownBtn.Position = UDim2.new(0, 10, 0, 25)
    dropdownBtn.Text = "Target: " .. _G.Settings[settingKey]
    dropdownBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    dropdownBtn.Font = Enum.Font.Gotham
    dropdownBtn.TextSize = 14
    dropdownBtn.BorderSizePixel = 0
    
    dropdownBtn.MouseButton1Click:Connect(function()
        -- Simple cycle through options
        local currentIndex = 0
        for i, option in ipairs(options) do
            if option == _G.Settings[settingKey] then
                currentIndex = i
                break
            end
        end
        local nextIndex = (currentIndex % #options) + 1
        _G.Settings[settingKey] = options[nextIndex]
        dropdownBtn.Text = "Target: " .. _G.Settings[settingKey]
    end)
    
    return frame
end

