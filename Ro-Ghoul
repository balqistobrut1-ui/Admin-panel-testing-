-- FUNGSI UTAMA (CORE LOGIC)
spawn(function()
    while wait(0.1) do
        -- Auto Equip Kagune/Quinque
        if _G.Settings.AutoEquip then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                local backpack = player.Backpack
                
                if char and not char:FindFirstChildOfClass("Tool") then
                    for _, tool in pairs(backpack:GetChildren()) do
                        if tool:IsA("Tool") and (tool.Name:find("Kagune") or tool.Name:find("Quinque") or tool.Name:find("Kakuhou")) then
                            char.Humanoid:EquipTool(tool)
                            break
                        end
                    end
                end
            end)
        end
        
        -- Auto Skill
        if _G.Settings.AutoSkill then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                
                if char and char:FindFirstChildOfClass("Tool") then
                    for i = 1, 6 do
                        if _G.Settings["Skill" .. i] then
                            -- Fire skill activation
                            local args = {[1] = i}
                            local remote = game:GetService("ReplicatedStorage"):FindFirstChild("ActivateSkill") or 
                                         game:GetService("ReplicatedStorage"):FindFirstChild("Skill") or
                                         game:GetService("ReplicatedStorage"):FindFirstChild("UseSkill")
                            if remote then
                                remote:FireServer(unpack(args))
                            end
                            wait(0.05)
                        end
                    end
                end
            end)
        end
        
        -- Auto Corps (ambil mayat)
        if _G.Settings.AutoCorps then
            pcall(function()
                for _, v in pairs(workspace:GetChildren()) do
                    if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                        local hum = v:FindFirstChild("Humanoid")
                          if hum and hum.Health <= 0 then
                            -- Ada mayat, coba ambil (klik detector)
                            local clickDetector = v:FindFirstChildOfClass("ClickDetector")
                            if clickDetector then
                                fireclickdetector(clickDetector)
                            end
                        end
                    end
                end
            end)
        end
        
        -- Auto Farm
        if _G.Settings.AutoFarm then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                -- Cari target sesuai pilihan
                local targetNPC = nil
                local targetNames = {
                    Aogiri = {"Aogiri", "Ghoul"},
                    Human = {"Human", "Civilian"},
                    CCG = {"CCG", "Investigator", "Doves"}
                }
                
                local names = targetNames[_G.Settings.FarmTarget] or {"Ghoul"}
                
                local closest = math.huge
                for _, v in pairs(workspace:GetChildren()) do
                    if v:FindFirstChild("Humanoid") then
                        for _, name in ipairs(names) do
                            if v.Name:find(name) then
                                local dist = (char.HumanoidRootPart.Position - v.HumanoidRootPart.Position).magnitude
                                if dist < closest then
                                    closest = dist
                                    targetNPC = v
                                end
                                break
                            end
                        end
                    end
                end
                
                if targetNPC then
                    -- Tween/gerak ke target dengan speed
                    local speed = _G.Settings.FarmSpeed / 10 -- Convert ke speed yg masuk akal
                    char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame:lerp(targetNPC.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5), speed/10)
                end
            end)
        end
        
        -- Auto Boss
        if _G.Settings.AutoBoss then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char then return end
                
                -- Daftar boss di Ro-Ghoul
                local bossList = {"Eto", "Ayato", "Tsukiyama", "Jason", "Yamori", "Arima"}
                local foundBoss = nil
                
                for _, bossName in ipairs(bossList) do
                    local boss = workspace:FindFirstChild(bossName)
                    if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                        foundBoss = boss
                        break
                    end
                end
                
                if foundBoss then
                    local speed = _G.Settings.BossSpeed / 10
                    char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame:lerp(foundBoss.HumanoidRootPart.CFrame * CFrame.new(0, 0, 5), speed/10)
                end
            end)
        end
        
        -- Auto Trainer
        if _G.Settings.AutoTrainer then
            pcall(function()
                -- Cari trainer area dan selesaikan
                for _, v in pairs(workspace:GetChildren()) do
                    if v.Name == "Trainer" or v.Name == "TrainingArea" then
                        -- Logika trainer (biasanya ada part yang harus disentuh)
                        local trainerPart = v:FindFirstChild("Part") or v:FindFirstChildOfClass("Part")
                        if trainerPart then
                            game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = trainerPart.CFrame
                        end
                        break
                    end
                end
            end)
        end
        
        -- Auto Quest
        if _G.Settings.AutoQuest then
            pcall(function()
                -- Ambil quest terbaru
                local questRemote = game:GetService("ReplicatedStorage"):FindFirstChild("GetQuest") or
                                    game:GetService("ReplicatedStorage"):FindFirstChild("Quest")
                if questRemote then
                    questRemote:FireServer()
                end
            end)
        end
    end
end)

