        btn.TextSize = 16
        btn.BorderSizePixel = 0
        
        btn.MouseButton1Click:Connect(function()
            _G.Settings["Skill" .. skillNum] = not _G.Settings["Skill" .. skillNum]
            btn.BackgroundColor3 = _G.Settings["Skill" .. skillNum] and Color3.fromRGB(60, 200, 60) or Color3.fromRGB(200, 60, 60)
        end)
    end
    
    -- Buat 6 tombol skill (E1 sampai E6)
    createSkillToggle(0, 1)
    createSkillToggle(70, 2)
    createSkillToggle(140, 3)
    createSkillToggle(210, 4)
    createSkillToggle(280, 5)
    createSkillToggle(350, 6)
    
    return frame
