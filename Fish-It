--[[
    Script untuk Game: Fish It! (钓鱼吧! 🐟)
    Fitur: Auto Fish, Instant Catch, UI Draggable, Buka/Tutup UI (Tombol F)
    Ukuran: < 547 token
--]]

-- Konfigurasi
local KeyToToggle = "F" -- Tombol untuk buka/tutup UI (F)

-- Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local Mouse = LocalPlayer:GetMouse()

-- Variabel Status
local isFarming = false
local isUIVisible = true
local guiMain, guiFrame, dragToggle, dragStart, dragInput, dragPos

-- Fungsi untuk Membuat GUI
local function createGUI()
    if CoreGui:FindFirstChild("FishItUI") then
        CoreGui:FindFirstChild("FishItUI"):Destroy()
    end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FishItUI"
    screenGui.Parent = CoreGui
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local mainFrame = Instance.new("Frame")
    mainFrame.Name = "MainFrame"
    mainFrame.Size = UDim2.new(0, 220, 0, 120)
    mainFrame.Position = UDim2.new(0.5, -110, 0.8, -60)
    mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    mainFrame.BackgroundTransparency = 0.15
    mainFrame.Active = true
    mainFrame.Draggable = false
    mainFrame.Parent = screenGui

    local uiCorner = Instance.new("UICorner")
    uiCorner.CornerRadius = UDim.new(0, 8)
    uiCorner.Parent = mainFrame

    local titleBar = Instance.new("Frame")
    titleBar.Size = UDim2.new(1, 0, 0, 30)
    titleBar.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
    titleBar.BorderSizePixel = 0
    titleBar.Parent = mainFrame

    local titleCorner = Instance.new("UICorner")
    titleCorner.CornerRadius = UDim.new(0, 8)
    titleCorner.Parent = titleBar

    local titleText = Instance.new("TextLabel")
    titleText.Size = UDim2.new(1, -40, 1, 0)
    titleText.Position = UDim2.new(0, 10, 0, 0)
    titleText.BackgroundTransparency = 1
    titleText.Text = "🐟 Fish It! Panel"
    titleText.TextColor3 = Color3.new(1, 1, 1)
    titleText.TextXAlignment = Enum.TextXAlignment.Left
    titleText.Font = Enum.Font.GothamBold
    titleText.TextSize = 14
    titleText.Parent = titleBar

    local closeBtn = Instance.new("TextButton")
    closeBtn.Size = UDim2.new(0, 30, 0, 30)
    closeBtn.Position = UDim2.new(1, -30, 0, 0)
    closeBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
    closeBtn.Text = "X"
    closeBtn.TextColor3 = Color3.new(1, 1, 1)
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 16
    closeBtn.Parent = titleBar

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 6)
    closeCorner.Parent = closeBtn

    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0, 200, 0, 40)
    toggleBtn.Position = UDim2.new(0.5, -100, 0, 45)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    toggleBtn.Text = "Mulai Auto Fish (OFF)"
    toggleBtn.TextColor3 = Color3.new(1, 1, 1)
    toggleBtn.Font = Enum.Font.Gotham
    toggleBtn.TextSize = 16
    toggleBtn.Parent = mainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = toggleBtn

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -10, 0, 25)
    statusLabel.Position = UDim2.new(0, 5, 0, 90)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "Status: Berhenti"
    statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 12
    statusLabel.Parent = mainFrame

    return screenGui, mainFrame, toggleBtn, statusLabel, titleBar
end

-- Membuat GUI dan menyimpan referensinya
guiMain, guiFrame, toggleButton, statusText, dragBar = createGUI()

-- Fungsi Drag (seret) UI
dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragToggle = true
        dragStart = input.Position
        dragPos = guiFrame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragToggle = false
            end
        end)
    end
end)

dragBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragToggle then
        local delta = input.Position - dragStart
        guiFrame.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X, dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
    end
end)

-- Fungsi untuk toggle UI (buka/tutup)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode[KeyToToggle] then
        isUIVisible = not isUIVisible
        guiMain.Enabled = isUIVisible
    end
end)

-- Fungsi inti Auto Fish
local function autoFish()
    while isFarming do
        RunService.Heartbeat:Wait()
        -- Logika deteksi dan tangkap ikan
        local rod = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Rod")
        if rod then
            local cast = rod:FindFirstChild("Cast") or rod:FindFirstChild("Bobber")
            if cast then
                -- Simulasi klik cepat saat ikan menggigit
                local biteEvent = cast:FindFirstChild("Bite") or cast:FindFirstChild("FishBite")
                if biteEvent then
                    fireclickdetector(biteEvent)
                    statusText.Text = "Status: Ikan Tertangkap!"
                else
                    statusText.Text = "Status: Menunggu ikan..."
                end
            end
        end
        wait(0.5) -- Hindari loop terlalu cepat
    end
    statusText.Text = "Status: Berhenti"
end

-- Toggle Auto Fish
toggleButton.MouseButton1Click:Connect(function()
    isFarming = not isFarming
    if isFarming then
        toggleButton.Text = "Hentikan Auto Fish (ON)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(200, 70, 70)
        statusText.Text = "Status: Memulai..."
        coroutine.wrap(autoFish)()
    else
        toggleButton.Text = "Mulai Auto Fish (OFF)"
        toggleButton.BackgroundColor3 = Color3.fromRGB(70, 130, 200)
    end
end)

-- Notifikasi awal
game.StarterGui:SetCore("SendNotification", {
    Title = "Fish It! Script Loaded",
    Text = "Tekan " .. KeyToToggle .. " untuk buka/tutup UI",
    Duration = 5
})

print("✅ Script Fish It! siap digunakan. Tekan " .. KeyToToggle .. " untuk toggle UI.")
