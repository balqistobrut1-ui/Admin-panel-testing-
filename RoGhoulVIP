-- [[ FARMING LOGIC ]] --
local function GetTarget()
    local target = nil; local dist = math.huge
    for _, v in pairs(workspace:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v ~= LP.Character then
            if v.Name:find("Aogiri") or v.Name:find("CCG") or v:FindFirstChild("Rank") then
                local d = (LP.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d; target = v end
            end
        end
    end
    return target
end

