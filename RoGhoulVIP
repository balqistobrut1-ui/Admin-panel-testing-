-- [[ UI COMPONENTS ]] --
local function CreateToggle(name, pos, cb)
    local b = Instance.new("TextButton", MainFrame)
    b.Size = UDim2.new(0, 280, 0, 35); b.Position = pos
    b.Text = name .. ": OFF"; b.BackgroundColor3 = Color3.fromRGB(35, 35, 35); b.TextColor3 = Color3.new(1,1,1)
    local s = false
    b.MouseButton1Click:Connect(function()
        s = not s
        b.Text = name .. ": " .. (s and "ON" or "OFF")
        b.BackgroundColor3 = s and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(35, 35, 35)
        cb(s)
    end)
end

