-- [[ SLIDER SETUP ]] --
local Speed = 100
local SliderFrame = Instance.new("Frame", MainFrame)
SliderFrame.Size = UDim2.new(0, 240, 0, 10); SliderFrame.Position = UDim2.new(0, 20, 0, 220)
SliderFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)

local SliderBtn = Instance.new("TextButton", SliderFrame)
SliderBtn.Size = UDim2.new(0, 20, 0, 20); SliderBtn.Position = UDim2.new(0.5, -10, 0, -5)
SliderBtn.Text = ""; SliderBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)

local SpeedDisplay = Instance.new("TextLabel", MainFrame)
SpeedDisplay.Size = UDim2.new(1, 0, 0, 20); SpeedDisplay.Position = UDim2.new(0, 0, 0, 195)
SpeedDisplay.Text = "Tween Speed: 100"; SpeedDisplay.TextColor3 = Color3.new(1,1,1); SpeedDisplay.BackgroundTransparency = 1

-- Slider Logic
local dragging = false
SliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true end
end)
game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local pos = math.clamp((input.Position.X - SliderFrame.AbsolutePosition.X) / SliderFrame.AbsoluteSize.X, 0, 1)
        SliderBtn.Position = UDim2.new(pos, -10, 0, -5)
        Speed = math.floor(pos * 200)
        SpeedDisplay.Text = "Tween Speed: " .. tostring(Speed)
    end
end)

-- [[ TOGGLE MAKER ]] --
local function AddToggle(name, pos, callback)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0, 240, 0, 40); btn.Position = pos
    btn.Text = name .. ": OFF"; btn.BackgroundColor3 = Color3.fromRGB(40,40,40); btn.TextColor3 = Color3.new(1,1,1)
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(40,40,40)
        callback(state)
    end)
end

-- [[ LOGIC FARM ]] --
AddToggle("Teleport Farm (Instant)", UDim2.new(0, 20, 0, 50), function(v) _G.Tele = v end)
AddToggle("Tween Farm (Slider)", UDim2.new(0, 20, 0, 100), function(v) _G.Tween = v end)
AddToggle("Auto Stats", UDim2.new(0, 20, 0, 150), function(v) _G.Stats = v end)

spawn(function()
    while task.wait() do
        pcall(function()
            if _G.Tele or _G.Tween then
                for _, npc in pairs(workspace.NPCs:GetChildren()) do
                    if npc:FindFirstChild("Humanoid") and npc.Humanoid.Health > 0 then
                        local targetPos = npc.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        
                        if _G.Tele then
                            LP.Character.HumanoidRootPart.CFrame = targetPos
                        elseif _G.Tween then
                            local dist = (LP.Character.HumanoidRootPart.Position - targetPos.Position).Magnitude
                            local tween = TweenService:Create(LP.Character.HumanoidRootPart, TweenInfo.new(dist/math.max(Speed, 1), Enum.EasingStyle.Linear), {CFrame = targetPos})
                            tween:Play()
                            if dist < 10 then tween:Cancel() end
                        end
                        
                        game:GetService("VirtualUser"):ClickButton1(Vector2.new(0,0))
                        if npc.Humanoid.Health <= 0 then break end
                    end
                end
            end
            
            if _G.Stats then
                game:GetService("ReplicatedStorage").Remotes.StatsV2:FireServer("Focus", "Physical", 1)
                game:GetService("ReplicatedStorage").Remotes.StatsV2:FireServer("Focus", "Durability", 1)
            end
        end)
    end
end)
          
