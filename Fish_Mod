-- 1. Instant Auto Fish (Berdasarkan Remote Net kamu)
CreateToggle("Instant Auto Fish", function(val)
    _G.Fishing = val
    spawn(function()
        while _G.Fishing do
            task.wait(0.5)
            pcall(function()
                local NetRE = game.ReplicatedStorage.Packages._Index["sleitnick_net@0.2.0"].net.RE
                local NetRF = game.ReplicatedStorage.Packages._Index["sleitnick_net@0.2.0"].net.RF
                
                -- Instant Cast
                NetRF.ChargeFishingRod:InvokeServer(100)
                NetRE.BaitCastVisual:FireServer(Vector3.new(0,0,0))
                
                -- Instant Catch
                task.wait(0.3)
                NetRE.FishCaught:FireServer(true)
                NetRE.FishingCompleted:FireServer()
            end)
        end
    end)
end)

-- 2. List Rarity untuk Favorite
local activeRarities = {}
local FavList = Instance.new("Frame", Content)
FavList.Size = UDim2.new(0.9, 0, 0, 180)
FavList.Position = UDim2.new(0.05, 0, 0, 100)
FavList.Visible = false
FavList.BackgroundTransparency = 1

local rarities = {"Common", "Uncommon", "Rare", "Epic", "Mythic", "Secret"}
for i, r in pairs(rarities) do
    local b = Instance.new("TextButton", FavList)
    b.Size = UDim2.new(1, 0, 0, 25)
    b.Position = UDim2.new(0, 0, 0, (i-1) * 28)
    b.Text = r .. ": OFF"
    b.MouseButton1Click:Connect(function()
        activeRarities[r] = not activeRarities[r]
        b.Text = r .. (activeRarities[r] and ": ON" or ": OFF")
        b.BackgroundColor3 = activeRarities[r] and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(60,60,60)
    end)
end

CreateToggle("▼ Favorite Settings", function(val)
    FavList.Visible = val
    Content.CanvasSize = val and UDim2.new(0,0,2,0) or UDim2.new(0,0,1.5,0)
end)

-- Logic Favorite (Detection)
pcall(function()
    local NetRE = game.ReplicatedStorage.Packages._Index["sleitnick_net@0.2.0"].net.RE
    NetRE.ObtainedNewFishNotification.OnClientEvent:Connect(function(data)
        if data and activeRarities[data.Rarity] then
            NetRE.FavoriteItem:FireServer(data.Id or data.Name)
        end
    end)
end)

