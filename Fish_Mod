-- Buttons (X, -)
local function CreateActionBtn(txt, pos, color, cb)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 35, 1, 0)
    b.Position = pos
    b.Text = txt
    b.BackgroundColor3 = color
    b.Parent = TopBar
    b.MouseButton1Click:Connect(cb)
end

CreateActionBtn("X", UDim2.new(1, -35, 0, 0), Color3.fromRGB(150, 0, 0), function() ScreenGui:Destroy() end)
CreateActionBtn("-", UDim2.new(1, -105, 0, 0), Color3.fromRGB(60, 60, 60), function() MainFrame.Visible = false ModBtn.Visible = true end)
ModBtn.MouseButton1Click:Connect(function() MainFrame.Visible = true ModBtn.Visible = false end)

-- Toggle & Dropdown State
local activeFavs = {Common = false, Uncommon = false, Rare = false, Epic = false, Mythic = false, Secret = false}

local function CreateToggle(name, pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 260, 0, 40)
    btn.Position = pos
    btn.Text = name .. ": OFF"
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Parent = MainFrame
    
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = name .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(45, 45, 45)
        callback(state)
    end)
end

-- [[ FITUR 1: INSTANT AUTO FISH ]]
CreateToggle("Instant Auto Fish", UDim2.new(0, 20, 0, 50), function(val)
    _G.AutoFish = val
    spawn(function()
        while _G.AutoFish do
            task.wait(0.2)
            -- Instant Cast
            NetRF.ChargeFishingRod:InvokeServer(100)
            NetRE.BaitCastVisual:FireServer(Vector3.new(0, 0, 0))
            
            -- Instant Catch
            task.wait(0.4) -- Delay sedikit biar server nggak curiga/crash
            NetRE.FishCaught:FireServer(true)
            NetRE.FishingCompleted:FireServer()
        end
    end)
end)

-- [[ FITUR 2: AUTO FAVORITE LIST ]]
local FavList = Instance.new("ScrollingFrame")
FavList.Size = UDim2.new(0.8, 0, 0, 150)
FavList.Position = UDim2.new(0.1, 0, 0, 250)
FavList.Visible = false
FavList.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
FavList.Parent = MainFrame

for i, r in pairs({"Common", "Uncommon", "Rare", "Epic", "Mythic", "Secret"}) do
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.Position = UDim2.new(0, 0, 0, (i-1)*30)
    b.Text = r .. ": OFF"
    b.Parent = FavList
    b.MouseButton1Click:Connect(function()
        activeFavs[r] = not activeFavs[r]
        b.Text = r .. (activeFavs[r] and ": ON" or ": OFF")
        b.BackgroundColor3 = activeFavs[r] and Color3.fromRGB(0, 100, 200) or Color3.fromRGB(40, 40, 40)
    end)
end

CreateToggle("▼ Favorite Settings", UDim2.new(0, 20, 0, 100), function(val)
    FavList.Visible = val
end)

-- LOGIC: Mendeteksi ikan baru dan Favorite-kan otomatis
NetRE.ObtainedNewFishNotification.OnClientEvent:Connect(function(fishData)
    -- fishData biasanya berisi {Name = "...", Rarity = "Secret", Id = ...}
    if fishData and activeFavs[fishData.Rarity] then
        NetRE.FavoriteItem:FireServer(fishData.Id or fishData.Name)
        print("Berhasil Favorite: " .. fishData.Rarity)
    end
end)
