CreateToggle("Instant Catch", UDim2.new(0, 20, 0, 100), function(val)
    FastCatchEnabled = val
    if FastCatchEnabled then
        -- Blatant Method: Bypass minigame
        game:GetService("RunService").Stepped:Connect(function()
            if not FastCatchEnabled then return end
            -- Mencari RemoteEvent 'FishCaught' atau 'Result'
            -- Contoh umum di game Fish It:
