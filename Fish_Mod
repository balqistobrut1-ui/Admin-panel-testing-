end)

-- 2. DROPDOWN AUTO FAVORITE
local FavList = Instance.new("ScrollingFrame")
FavList.Size = UDim2.new(0.8, 0, 0, 150)
FavList.Position = UDim2.new(0.1, 0, 0, 200)
FavList.Visible = false
FavList.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
FavList.Parent = MainFrame

local rarities = {"Common", "Uncommon", "Rare", "Epic", "Mythic", "Secret"}
local activeFavs = {}

for i, r in pairs(rarities) do
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.Position = UDim2.new(0, 0, 0, (i-1)*30)
    b.Text = r .. ": OFF"
    b.Parent = FavList
    b.MouseButton1Click:Connect(function()
        activeFavs[r] = not activeFavs[r]
        b.Text = r .. (activeFavs[r] and ": ON" or ": OFF")
        b.BackgroundColor3 = activeFavs[r] and Color3.fromRGB(0, 120, 255) or Color3.fromRGB(50, 50, 50)
    end)
end

CreateToggle("▼ Select Favorite Rarity", UDim2.new(0, 20, 0, 100), function(val)
    FavList.Visible = val
end)

