local Player = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

-- Variabel
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")

-- Settings
local Settings = {
    AutoTP = true,
    AutoFinish = true,
    TPSpeed = 0.3, -- Kecepatan teleport
    ShowGUI = true
}

-- Cari semua checkpoint
local Checkpoints = {}
local FinishPart = nil

local function ScanCheckpoints()
    Checkpoints = {}
    FinishPart = nil
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            
            -- Cari checkpoint
            if name:find("checkpoint") or name:find("cp") or name:find("stage") then
                table.insert(Checkpoints, obj)
            end
            
            -- Cari finish
            if name:find("finish") or name:find("end") or name:find("goal") or name:find("win") then
                FinishPart = obj
            end
        end
    end
    
    -- Urutin checkpoint berdasarkan posisi
    table.sort(Checkpoints, function(a, b)
        return a.Position.Y < b.Position.Y
    end)
    
    return #Checkpoints
end

-- Fungsi teleport
local function TeleportTo(part)
    if part and part.Position then
        RootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
        return true
    end
    return false
end

-- Cari checkpoint berikutnya
local function GetNextCheckpoint()
    if #Checkpoints == 0 then return nil end
    
    local charPos = RootPart.Position
    local nextCP = nil
    local minDist = math.huge
    
    for _, cp in ipairs(Checkpoints) do
        local dist = (cp.Position - charPos).Magnitude
        if dist < minDist and dist > 5 then
            minDist = dist
            nextCP = cp
        end
    end
    
    return nextCP
end

