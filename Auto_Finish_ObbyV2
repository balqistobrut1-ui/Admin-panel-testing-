        if FinishPart then
            TeleportTo(FinishPart)
            wait(0.5)
            -- Coba trigger finish
            pcall(function()
                game:GetService("ReplicatedStorage"):FindFirstChild("Finish"):FireServer()
                game:GetService("ReplicatedStorage"):FindFirstChild("Win"):FireServer()
