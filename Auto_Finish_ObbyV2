        Settings.AutoTP = not Settings.AutoTP
        ToggleBtn.BackgroundColor3 = Settings.AutoTP and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(200, 0, 0)
        ToggleBtn.Text = Settings.AutoTP and "AUTO: ON" or "AUTO: OFF"
    end)
    
    -- Drag GUI (untuk Android)
    local dragging = false
    local dragStart, startPos
    
    Frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
        end
    end)
    
    Frame.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            Frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    
    Frame.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

-- Auto TP loop
spawn(function()
    while true do
        wait(Settings.TPSpeed)
        
        if Settings.AutoTP then
            local nextCP = GetNextCheckpoint()
            if nextCP then
                TeleportTo(nextCP)
            end
        end
    end
end)

-- Auto Finish
spawn(function()
    while true do
        wait(1)
        
        if Settings.AutoFinish and FinishPart then
            local dist = (RootPart.Position - FinishPart.Position).Magnitude
            if dist < 20 then
                -- Udah deket finish
                wait(0.5)
                pcall(function()
                    game:GetService("ReplicatedStorage"):FindFirstChild("Finish"):FireServer()
                end)
            end
        end
    end
end)

