-- [[ LOGIKA CORE (SISTEM DETEKSI & FARM) ]] --

local function GetClosestEnemy()
    local target, dist = nil, math.huge
    for _, v in pairs(workspace:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v ~= LP.Character then
            local isTarget = false
            if _G.TargetType == "Aogiri" and (v.Name:find("Aogiri") or v:FindFirstChild("Rank")) then isTarget = true
            elseif _G.TargetType == "CCG" and (v.Name:find("CCG") or v.Name:find("Investigator")) then isTarget = true
            elseif _G.TargetType == "Human" and (v.Name:find("Human") or v.Name:find("Citizen")) then isTarget = true
            end
            
            if isTarget then
                local d = (LP.Character.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d; target = v end
            end
        end
    end
    return target
end

-- Loop Utama (Deteksi & Serang)
spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if _G.AutoFarm or _G.AutoTween or _G.AutoBoss then
                local target = GetClosestEnemy()
                if target then
                    -- Pastikan Senjata Dipakai
                    if not LP.Character:FindFirstChildOfClass("Tool") then
                        local tool = LP.Backpack:FindFirstChildOfClass("Tool")
                        if tool then LP.Character.Humanoid:EquipTool(tool) end
                    end

                    -- Kalkulasi Posisi
                    local targetPos = target.HumanoidRootPart.CFrame
                    local myPos = LP.Character.HumanoidRootPart
                    local finalCFrame = targetPos * CFrame.new(0, (_G.AutoBoss and _G.Height or 0), 3)

                    -- Metode Pergerakan
                    if _G.AutoFarm or _G.AutoBoss then
                        myPos.CFrame = CFrame.new(finalCFrame.Position, targetPos.Position)
                    elseif _G.AutoTween then
                        local distance = (myPos.Position - finalCFrame.Position).Magnitude
                        local tInfo = TweenInfo.new(distance/math.max(_G.TweenSpeed, 1), Enum.EasingStyle.Linear)
                        TweenService:Create(myPos, tInfo, {CFrame = CFrame.new(finalCFrame.Position, targetPos.Position)}):Play()
                    end

                    -- Auto ATK (Mencari Tombol di Layar)
                    if _G.AutoAtk then
                        local gui = LP.PlayerGui:FindFirstChild("MainGui") or LP.PlayerGui:FindFirstChild("HUD")
                        if gui then
                            for _, btn in pairs(gui:GetDescendants()) do
                                if btn:IsA("TextButton") and (btn.Text:find("ATK") or btn.Name:find("Attack")) then
                                    VirtualInputManager:SendMouseButtonEvent(btn.AbsolutePosition.X + 20, btn.AbsolutePosition.Y + 20, 0, true, game, 1)
                                    VirtualInputManager:SendMouseButtonEvent(btn.AbsolutePosition.X + 20, btn.AbsolutePosition.Y + 20, 0, false, game, 1)
                                end
                            end
                        end
                    end

                    -- Auto Skill (E, R, F, C, V)
                    for key, active in pairs(_G.Skills) do
                        if active then
                            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode[key], false, game)
                            task.wait(0.05)
                            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode[key], false, game)
                        end
                    end
                end
            end

            -- Auto Eat Logic
            if _G.AutoEat then
                for _, corpse in pairs(workspace:GetChildren()) do
                    if corpse.Name == "Corpse" then
                        LP.Character.HumanoidRootPart.CFrame = corpse.CFrame
                        fireclickdetector(corpse:FindFirstChildOfClass("ClickDetector"))
                        break
                    end
                end
            end
        end)
    end
end)
