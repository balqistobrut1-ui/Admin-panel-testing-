-- File
local CFG = "TREX_HUB_CFG.json"
local function SaveCFG()
    if writefile then
        writefile(CFG, HttpService:JSONEncode(State))
    end
end
local function LoadCFG()
    if readfile and isfile and isfile(CFG) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(CFG))
        end)
        if ok and type(data)=="table" then
            for k,v in pairs(data) do State[k]=v end
        end
    end
end
LoadCFG()

