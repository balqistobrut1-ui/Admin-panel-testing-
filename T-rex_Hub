local function Toggle(name, get, set)
    local C = Instance.new("Frame", Body)
    C.Size = UDim2.new(1,-24,0,44)
    C.BackgroundColor3 = Color3.fromRGB(26,26,26)
    C.BorderSizePixel = 0
    Instance.new("UICorner", C).CornerRadius = UDim.new(0,10)

    local T = Instance.new("TextLabel", C)
    T.Text = name
    T.Size = UDim2.new(1,-80,1,0)
    T.Position = UDim2.new(0,12,0,0)
    T.TextColor3 = Color3.fromRGB(230,230,230)
    T.Font = Enum.Font.Gotham
    T.TextSize = 13
    T.BackgroundTransparency = 1
    T.TextXAlignment = Enum.TextXAlignment.Left

    local S = Instance.new("Frame", C)
    S.Size = UDim2.new(0,50,0,26)
    S.Position = UDim2.new(1,-62,0.5,-13)
    S.BackgroundColor3 = get() and Color3.fromRGB(40,160,80) or Color3.fromRGB(140,40,40)
    S.BorderSizePixel = 0
    Instance.new("UICorner", S).CornerRadius = UDim.new(1,0)

    local K = Instance.new("Frame", S)
    K.Size = UDim2.new(0,22,0,22)
    K.Position = get() and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11)
    K.BackgroundColor3 = Color3.fromRGB(245,245,245)
    Instance.new("UICorner", K).CornerRadius = UDim.new(1,0)

    local function redraw(v)
        TweenService:Create(S, TweenInfo.new(0.15), {
            BackgroundColor3 = v and Color3.fromRGB(40,160,80) or Color3.fromRGB(140,40,40)
        }):Play()
        TweenService:Create(K, TweenInfo.new(0.15), {
            Position = v and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11)
        }):Play()
    end

    S.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            local v = not get()
            set(v); redraw(v); SaveCFG()
        end
    end)
    redraw(get())
    return C
end

local function Slider(name, min, max, get, set)
    local C = Instance.new("Frame", Body)
    C.Size = UDim2.new(1,-24,0,56)
    C.BackgroundColor3 = Color3.fromRGB(26,26,26)
    C.BorderSizePixel = 0
    Instance.new("UICorner", C).CornerRadius = UDim.new(0,10)

    local T = Instance.new("TextLabel", C)
    T.Text = name
    T.Size = UDim2.new(1,-24,0,20)
    T.Position = UDim2.new(0,12,0,6)
    T.TextColor3 = Color3.fromRGB(230,230,230)
    T.Font = Enum.Font.Gotham
    T.TextSize = 13
    T.BackgroundTransparency = 1
    T.TextXAlignment = Enum.TextXAlignment.Left

    local Bar = Instance.new("Frame", C)
    Bar.Size = UDim2.new(1,-24,0,10)
    Bar.Position = UDim2.new(0,12,1,-18)
    Bar.BackgroundColor3 = Color3.fromRGB(50,50,50)
    Bar.BorderSizePixel = 0
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1,0)

    local Fill = Instance.new("Frame", Bar)
    Fill.Size = UDim2.new((get()-min)/(max-min),0,1,0)
    Fill.BackgroundColor3 = State.Accent
    Fill.BorderSizePixel = 0
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1,0)

    local drag=false
    local function upd(x)
        local a = math.clamp((x-Bar.AbsolutePosition.X)/Bar.AbsoluteSize.X,0,1)
        local v = math.floor(min + (max-min)*a)
        set(v)
        Fill.Size = UDim2.new(a,0,1,0)
        SaveCFG()
    end
    Bar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; upd(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            upd(i.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
    return C
end

