-- Toggle switch
local function Toggle(name,get,set)
    local c = Instance.new("Frame",Body)
    c.Size = UDim2.new(1,-24,0,44)
    c.BackgroundColor3 = Color3.fromRGB(26,26,26)
    c.BorderSizePixel = 0
    Instance.new("UICorner",c).CornerRadius = UDim.new(0,10)

    local l = Instance.new("TextLabel",c)
    l.Text = name
    l.Font = Enum.Font.Gotham
    l.TextSize = 13
    l.TextColor3 = Color3.fromRGB(230,230,230)
    l.BackgroundTransparency = 1
    l.Position = UDim2.new(0,12,0,0)
    l.Size = UDim2.new(1,-80,1,0)
    l.TextXAlignment = Left

    local s = Instance.new("Frame",c)
    s.Size = UDim2.new(0,50,0,26)
    s.Position = UDim2.new(1,-62,0.5,-13)
    s.BorderSizePixel = 0
    Instance.new("UICorner",s).CornerRadius = UDim.new(1,0)

    local k = Instance.new("Frame",s)
    k.Size = UDim2.new(0,22,0,22)
    Instance.new("UICorner",k).CornerRadius = UDim.new(1,0)

    local function draw(v)
        s.BackgroundColor3 = v and Color3.fromRGB(40,160,80) or Color3.fromRGB(150,50,50)
        k.Position = v and UDim2.new(1,-24,0.5,-11) or UDim2.new(0,2,0.5,-11)
    end
    draw(get())

    s.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            local v = not get()
            set(v)
            draw(v)
            Save()
        end
    end)
    return c
end

-- Slider
local function Slider(name,min,max,get,set)
    local c = Instance.new("Frame",Body)
    c.Size = UDim2.new(1,-24,0,56)
    c.BackgroundColor3 = Color3.fromRGB(26,26,26)
    c.BorderSizePixel = 0
    Instance.new("UICorner",c).CornerRadius = UDim.new(0,10)

    local t = Instance.new("TextLabel",c)
    t.Text = name
    t.Font = Enum.Font.Gotham
    t.TextSize = 13
    t.TextColor3 = Color3.fromRGB(230,230,230)
    t.BackgroundTransparency = 1
    t.Position = UDim2.new(0,12,0,6)
    t.Size = UDim2.new(1,-24,0,20)
    t.TextXAlignment = Left

    local bar = Instance.new("Frame",c)
    bar.Size = UDim2.new(1,-24,0,10)
    bar.Position = UDim2.new(0,12,1,-18)
    bar.BackgroundColor3 = Color3.fromRGB(60,60,60)
    bar.BorderSizePixel = 0
    Instance.new("UICorner",bar).CornerRadius = UDim.new(1,0)

    local fill = Instance.new("Frame",bar)
    fill.BackgroundColor3 = State.Accent
    fill.BorderSizePixel = 0
    Instance.new("UICorner",fill).CornerRadius = UDim.new(1,0)

    local function update(x)
        local a = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local v = math.floor(min + (max-min)*a)
        set(v)
        fill.Size = UDim2.new(a,0,1,0)
        Save()
    end
    fill.Size = UDim2.new((get()-min)/(max-min),0,1,0)

    bar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            update(i.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch then
            if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
                update(i.Position.X)
            end
        end
    end)
    return c
end

