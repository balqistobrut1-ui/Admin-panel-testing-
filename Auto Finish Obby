-- [[ LOGIC AUTO TELEPORT ]] --
spawn(function()
    while task.wait(0.1) do
        if _G.AutoObby then
            pcall(function()
                local char = LP.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                
                -- Mencari Checkpoints/Stages/Parts
                local folderNames = {"Checkpoints", "Stages", "Levels", "Spawns"}
                local checkpoints = {}

                for _, name in pairs(folderNames) do
                    local f = workspace:FindFirstChild(name) or workspace:FindFirstChild(name:lower())
                    if f then
                        for _, cp in pairs(f:GetChildren()) do
                            table.insert(checkpoints, cp)
                        end
                    end
                end

                -- Jika tidak ada folder khusus, cari part bernama angka atau "Stage"
                if #checkpoints == 0 then
                    for _, v in pairs(workspace:GetDescendants()) do
                        if v:IsA("BasePart") and (tonumber(v.Name) or v.Name:lower():find("stage") or v.Name:lower():find("checkpoint")) then
                            table.insert(checkpoints, v)
                        end
                    end
                end

                -- Urutkan berdasarkan nama (agar urut stage 1, 2, 3...)
                table.sort(checkpoints, function(a, b)
                    return tonumber(a.Name) or 0 < tonumber(b.Name) or 0
                end)

                -- Teleport ke setiap checkpoint dengan cepat
                for _, cp in ipairs(checkpoints) do
                    if not _G.AutoObby then break end
                    if cp:IsA("BasePart") then
                        root.CFrame = cp.CFrame * CFrame.new(0, 3, 0)
                        task.wait(0.05) -- Kecepatan teleport (sangat cepat)
                    end
                end
                
                -- Setelah semua checkpoint, cari finish line
                _G.AutoObby = false
                ToggleBtn.Text = "AUTO FINISH: OFF"
                ToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            end)
        end
    end
end)
