-- [[ LOGIC DETEKSI CERDAS ]] --
local function GetFinishPart()
    local keywords = {"finish", "goal", "end", "winner", "trophy", "victory", "final"}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Model") then
            for _, key in pairs(keywords) do
                if v.Name:lower():find(key) then
                    return (v:IsA("Model") and v:FindFirstChildWhichIsA("BasePart") or v)
                end
            end
        end
    end
    return nil
end

local function GetAllCheckpoints()
    local cp_table = {}
    local checkpoint_keywords = {"checkpoint", "stage", "spawn", "level", "part"}
    
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("SpawnLocation") then
            local name = v.Name:lower()
            local is_cp = false
            
            -- Cek berdasarkan nama
            for _, key in pairs(checkpoint_keywords) do
                if name:find(key) or tonumber(name) then
                    is_cp = true; break
                end
            end
            
            -- Cek jika part transparan (sering jadi invisible checkpoint)
            if v.Transparency > 0.5 and v.CanTouch == true and v.Size.Y < 2 then
                is_cp = true
            end

            if is_cp then table.insert(cp_table, v) end
        end
    end
    
    -- Urutkan berdasarkan angka di nama atau posisi Y jika tidak ada angka
    table.sort(cp_table, function(a, b)
        local aNum = tonumber(a.Name:match("%d+")) or a.Position.Y
        local bNum = tonumber(b.Name:match("%d+")) or b.Position.Y
        return aNum < bNum
    end)
    return cp_table
end

-- [[ BUTTONS ]] --
local function CreateButton(txt, pos, cb)
    local btn = Instance.new("TextButton", MainFrame)
    btn.Size = UDim2.new(0, 240, 0, 45); btn.Position = pos
    btn.Text = txt .. ": OFF"; btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40); btn.TextColor3 = Color3.new(1, 1, 1)
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = txt .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(40, 40, 40)
        cb(state)
    end)
end

