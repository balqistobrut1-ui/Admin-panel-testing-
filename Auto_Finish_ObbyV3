    Frame.Position = UDim2.new(1, -190, 1, -170)
    Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    Frame.BackgroundTransparency = 0.1
    Frame.Active = true
    Frame.Draggable = true
    Frame.Parent = GUI
    
    -- Judul
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    Title.Text = "🎣 AUTO FISH MOD"
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 14
    Title.Parent = Frame
    
    -- Tombol Start/Stop Auto Fish
    local FishBtn = Instance.new("TextButton")
    FishBtn.Size = UDim2.new(0.9, 0, 0, 35)
    FishBtn.Position = UDim2.new(0.05, 0, 0, 35)
    FishBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    FishBtn.Text = "START FISH"
    FishBtn.TextColor3 = Color3.new(1, 1, 1)
    FishBtn.Font = Enum.Font.GothamBold
    FishBtn.TextSize = 13
    FishBtn.Parent = Frame
    
    -- Tombol Auto Sell
    local SellBtn = Instance.new("TextButton")
    SellBtn.Size = UDim2.new(0.9, 0, 0, 35)
    SellBtn.Position = UDim2.new(0.05, 0, 0, 75)
    SellBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
    SellBtn.Text = "AUTO SELL: OFF"
    SellBtn.TextColor3 = Color3.new(1, 1, 1)
    SellBtn.Font = Enum.Font.Gotham
    SellBtn.TextSize = 12
    SellBtn.Parent = Frame
    
    -- Status remote
    local Status = Instance.new("TextLabel")
    Status.Size = UDim2.new(1, 0, 0, 20)
    Status.Position = UDim2.new(0, 0, 1, -25)
    Status.BackgroundTransparency = 1
    Status.Text = "🔍 Mencari remote..."
    Status.TextColor3 = Color3.fromRGB(255, 255, 0)
    Status.Font = Enum.Font.Gotham
    Status.TextSize = 10
    Status.Parent = Frame
    
    -- Cek remote
    spawn(function()
        if FindRemotes() then
            Status.Text = "✅ Remote ditemukan! Mode NO DELAY"
            Status.TextColor3 = Color3.fromRGB(0, 255, 0)
        else
            Status.Text = "❌ Remote gak ditemukan"
            Status.TextColor3 = Color3.fromRGB(255, 0, 0)
        end
    end)
    
    -- Event tombol
    FishBtn.MouseButton1Click:Connect(function()
        Settings.AutoFish = not Settings.AutoFish
        
        if Settings.AutoFish then
            FishBtn.Text = "STOP FISH"
            FishBtn.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
            
            -- Mulai loop
            spawn(AutoFishLoop)
        else
            FishBtn.Text = "START FISH"
            FishBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        end
    end)
    
    SellBtn.MouseButton1Click:Connect(function()
        Settings.AutoSell = not Settings.AutoSell
        
        if Settings.AutoSell then
            SellBtn.Text = "AUTO SELL: ON"
            SellBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            
            -- Mulai loop jual
            spawn(AutoSellLoop)
        else
            SellBtn.Text = "AUTO SELL: OFF"
            SellBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
        end
    end)
end

-- Keybind F buat toggle (alternatif)
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        Settings.AutoFish = not Settings.AutoFish
        
        if Settings.AutoFish then
            print("🎣 Auto Fish ON")
            spawn(AutoFishLoop)
        else
            print("🎣 Auto Fish OFF")
        end
    elseif input.KeyCode == Enum.KeyCode.G then
        Settings.AutoSell = not Settings.AutoSell
        
        if Settings.AutoSell then
            print("💰 Auto Sell ON")
            spawn(AutoSellLoop)
        else
            print("💰 Auto Sell OFF")
        end
    end
end)

