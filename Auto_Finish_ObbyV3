-- Cek apakah di game Fish It
if game.PlaceId ~= 98231063560646 then
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Error",
        Text = "Ini bukan game Fish It!",
        Duration = 3
    })
    return
end

local Player = game:GetService("Players").LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Settings
local Settings = {
    AutoFish = false,
    FastMode = true,  -- Mode cepat (pake remote)
    AutoSell = false,
    ShowGUI = true
}

-- Cari remote events (yang bikin cepet)
local Remotes = {
    Cast = nil,
    Reel = nil,
    Sell = nil
}

-- Fungsi buat cari remote events
local function FindRemotes()
    -- Cara 1: Cari di Packages
    local packages = ReplicatedStorage:FindFirstChild("Packages")
    if packages then
        local net = packages:FindFirstChild("_index"):FindFirstChild("sleitnick_net@0.2.0")
        if net and net:FindFirstChild("net") then
            net = net.net
            
            -- Cari remote yang diperlukan
            Remotes.Cast = net:FindFirstChild("RF/ChargeFishingRod")
            Remotes.Reel = net:FindFirstChild("RE/FishingCompleted")
            
            -- Cari remote jual ikan
            local sellRemote = net:FindFirstChild("RE/SellAll")
            if sellRemote then
                Remotes.Sell = sellRemote
            end
        end
    end
    
    -- Cara 2: Cari langsung (fallback)
    if not Remotes.Cast then
        for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
            if obj.Name == "ChargeFishingRod" or obj.Name == "Cast" then
                Remotes.Cast = obj
            elseif obj.Name == "FishingCompleted" or obj.Name == "Reel" then
                Remotes.Reel = obj
            end
        end
    end
    
    return Remotes.Cast and Remotes.Reel
end

-- Fungsi auto fish (pake remote = no delay)
local function AutoFishLoop()
    while Settings.AutoFish do
        -- Equip tool dulu (biar aman)
        pcall(function()
            local tool = Player.Character:FindFirstChild("Fishing Rod") or 
                        Player.Backpack:FindFirstChild("Fishing Rod")
            if tool and Player.Character then
                Player.Character.Humanoid:EquipTool(tool)
            end
        end)
        
        -- Cast pake remote (langsung, gada delay)
        if Remotes.Cast and Remotes.Cast:IsA("RemoteFunction") then
            pcall(function()
                Remotes.Cast:InvokeServer(1)  -- 1 = max charge
            end)
        elseif Remotes.Cast and Remotes.Cast:IsA("RemoteEvent") then
            pcall(function()
                Remotes.Cast:FireServer()
            end)
        end
        
        -- Reel langsung (no delay)
        if Remotes.Reel and Remotes.Reel:IsA("RemoteEvent") then
            pcall(function()
                Remotes.Reel:FireServer()
            end)
        end
        
        -- Kasih jeda kecil biar gak overflow
        task.wait(0.05)
    end
end

-- Fungsi auto jual
local function AutoSellLoop()
    while Settings.AutoSell do
        if Remotes.Sell then
            pcall(function()
                Remotes.Sell:FireServer()
            end)
        end
        task.wait(5)  -- Jual tiap 5 detik
    end
end

-- GUI Simple buat Android
if Settings.ShowGUI then
