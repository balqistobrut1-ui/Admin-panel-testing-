    if CoreGui:FindFirstChild("FishGUI") then
        CoreGui:FindFirstChild("FishGUI"):Destroy()
    end
    
    local GUI = Instance.new("ScreenGui")
    GUI.Name = "FishGUI"
    GUI.Parent = CoreGui
    GUI.ResetOnSpawn = false
    
    -- Frame (posisi kanan bawah buat Android)
    local Frame = Instance.new("Frame")
