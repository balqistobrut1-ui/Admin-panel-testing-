-- Search Function
local function GetTarget(mode)
    local closest = nil
    local dist = 1000
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Humanoid") and v.Parent:FindFirstChild("HumanoidRootPart") and v.Parent ~= LocalPlayer.Character then
            local player = Players:GetPlayerFromCharacter(v.Parent)
            local isValid = false
            if mode == "AI" and not player then isValid = true
            elseif mode == "Player" and player then isValid = true end
            
            if isValid then
                local d = (LocalPlayer.Character.HumanoidRootPart.Position - v.Parent.HumanoidRootPart.Position).Magnitude
                if d < dist then dist = d closest = v.Parent end
            end
        end
    end
    return closest
end

