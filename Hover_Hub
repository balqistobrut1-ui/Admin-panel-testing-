-- Slider Setup Function
local function setupSlider(btn, bar, label, prefix, callback)
    local sliding = false
    btn.InputBegan:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then sliding = true end end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local perc = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            btn.Position = UDim2.new(perc, -10, 0.5, -10)
            local val = math.floor((perc * 400) - 200)
            label.Text = prefix .. ": " .. tostring(val)
            callback(val)
        end
    end)
    UserInputService.InputEnded:Connect(function() sliding = false end)
end

