-- LOGIKA: AUTO GET VIP ITEMS
task.spawn(function()
    while true do
        task.wait(2)
        if autoGetItems then
            -- Script ini akan mencoba mengambil semua item yang ada di folder 'Items' atau 'Shop'
            -- Biasanya item premium ada di Workspace atau di dalam ProximityPrompt
            pcall(function()
                for _, v in pairs(game.Workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        -- Mencoba mengaktifkan semua prompt (termasuk item VIP)
                        fireproximityprompt(v)
                    elseif v:IsA("TouchTransmitter") and v.Parent:FindFirstChild("Handle") then
                        -- Mencoba menyentuh item yang tergeletak
                        firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v.Parent, 0)
                        firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v.Parent, 1)
                    end
                end
            end)
        end
    end
end)

