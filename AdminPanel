-- CLEAN FULL FEATURE HUB
if game.CoreGui:FindFirstChild("CleanHub") then
    game.CoreGui.CleanHub:Destroy()
end

-- SERVICES
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local TPService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local LP = Players.LocalPlayer

-- GUI
local Gui = Instance.new("ScreenGui", game.CoreGui)
Gui.Name = "CleanHub"

local Main = Instance.new("Frame", Gui)
Main.Size = UDim2.new(0, 540, 0, 380)
Main.Position = UDim2.new(0.5, -270, 0.5, -190)
Main.BackgroundColor3 = Color3.fromRGB(22,22,22)
Main.BorderSizePixel = 0
Main.Active = true
Main.Draggable = true

-- CONFIG
local Config = {
    WalkSpeed = 16,
    JumpPower = 50,
    FlySpeed = 30,
    Time = 14,
    Noclip = false,
    InfJump = false,
    Fullbright = false,
    NoFog = false
}

-- SAVE / LOAD
local function SaveConfig()
    writefile("CleanHub.json", HttpService:JSONEncode(Config))
end

local function LoadConfig()
    if isfile("CleanHub.json") then
        Config = HttpService:JSONDecode(readfile("CleanHub.json"))
    end
end

LoadConfig()

-- CHARACTER
local function GetChar()
    local c = LP.Character or LP.CharacterAdded:Wait()
    return c, c:WaitForChild("Humanoid"), c:WaitForChild("HumanoidRootPart")
end

-- ================= PLAYER FEATURES =================

-- NOCLIP
RunService.Stepped:Connect(function()
    if Config.Noclip then
        local char = LP.Character
        if char then
            for _,v in pairs(char:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                end
            end
        end
    end
end)

-- INFINITE JUMP
UIS.JumpRequest:Connect(function()
    if Config.InfJump then
        local _,hum = GetChar()
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- FULLBRIGHT
RunService.RenderStepped:Connect(function()
    if Config.Fullbright then
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.FogEnd = 1e9
    end
end)

-- NO FOG
if Config.NoFog then
    Lighting.FogEnd = 1e9
end

-- CLICK TP
UIS.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 and UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
        local mouse = LP:GetMouse()
        if mouse.Hit then
            local _,_,hrp = GetChar()
            hrp.CFrame = mouse.Hit + Vector3.new(0,3,0)
        end
    end
end)

-- ================= BUTTON EXAMPLES =================

local function Button(text, y, callback)
    local b = Instance.new("TextButton", Main)
    b.Size = UDim2.new(0,240,0,32)
    b.Position = UDim2.new(0,20,0,y)
    b.Text = text
    b.BackgroundColor3 = Color3.fromRGB(35,35,35)
    b.TextColor3 = Color3.new(1,1,1)
    b.MouseButton1Click:Connect(callback)
end

Button("Toggle Noclip", 40, function()
    Config.Noclip = not Config.Noclip
end)

Button("Infinite Jump", 80, function()
    Config.InfJump = not Config.InfJump
end)

Button("Fullbright", 120, function()
    Config.Fullbright = not Config.Fullbright
end)

Button("Reset Character", 160, function()
    LP.Character:BreakJoints()
end)

Button("Rejoin", 200, function()
    TPService:Teleport(game.PlaceId, LP)
end)

Button("Save Config", 240, SaveConfig)

-- ================= END =================
