-- ================== UI UTILS ==================
local function Button(text, y, callback)
	local b = Instance.new("TextButton", Main)
	b.Size = UDim2.new(0,240,0,32)
	b.Position = UDim2.new(0,20,0,y)
	b.Text = text
	b.Font = Enum.Font.Gotham
	b.TextSize = 14
	b.TextColor3 = Color3.new(1,1,1)
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)
	b.MouseButton1Click:Connect(callback)
	return b
end

local function Toggle(text, y, state, callback)
	local t = Button(text.." : "..tostring(state), y, function()
		state = not state
		t.Text = text.." : "..tostring(state)
		callback(state)
	end)
end

local function Box(text, y, default, callback)
	local b = Instance.new("TextBox", Main)
	b.Size = UDim2.new(0,240,0,32)
	b.Position = UDim2.new(0,20,0,y)
	b.Text = text..": "..tostring(default)
	b.BackgroundColor3 = Color3.fromRGB(40,40,40)
	b.TextColor3 = Color3.new(1,1,1)
	b.FocusLost:Connect(function()
		local n = tonumber(b.Text:match("%d+"))
		if n then callback(n) end
	end)
end

-- ================== FEATURES ==================

-- WalkSpeed
Box("WalkSpeed",60,Config.WalkSpeed,function(v)
	Config.WalkSpeed = math.clamp(v,1,500)
	GetChar():WaitForChild("Humanoid").WalkSpeed = Config.WalkSpeed
	SaveConfig()
end)

-- JumpPower
Box("JumpPower",100,Config.JumpPower,function(v)
	Config.JumpPower = math.clamp(v,1,500)
	GetChar():WaitForChild("Humanoid").JumpPower = Config.JumpPower
	SaveConfig()
end)

-- Noclip
Toggle("Noclip",140,Config.Noclip,function(v)
	Config.Noclip = v
end)

RunService.Stepped:Connect(function()
	if Config.Noclip then
		for _,v in pairs(LP.Character:GetDescendants()) do
			if v:IsA("BasePart") then v.CanCollide = false end
		end
	end
end)

-- Infinite Jump
Toggle("Infinite Jump",180,Config.InfJump,function(v)
	Config.InfJump = v
end)

UIS.JumpRequest:Connect(function()
	if Config.InfJump then
		GetChar():WaitForChild("Humanoid"):ChangeState("Jumping")
	end
end)

-- Click Teleport
Toggle("Click TP",220,false,function(v)
	if v then
		local con
		con = UIS.InputBegan:Connect(function(i,g)
			if i.UserInputType == Enum.UserInputType.MouseButton1 then
				local pos = LP:GetMouse().Hit.p
				GetChar():WaitForChild("HumanoidRootPart").CFrame = CFrame.new(pos+Vector3.new(0,3,0))
			end
		end)
	end
end)

-- Fullbright
Toggle("Fullbright",260,Config.Fullbright,function(v)
	Config.Fullbright = v
	if v then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.FogEnd = 1e9
	end
end)

-- No Fog
Toggle("No Fog",300,Config.NoFog,function(v)
	Config.NoFog = v
	if v then Lighting.FogEnd = 1e9 end
end)

-- Reset Character
Button("Reset Character",340,function()
