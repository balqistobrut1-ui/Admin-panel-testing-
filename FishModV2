-- Status State
local activeFavs = {Common=false, Uncommon=false, Rare=false, Epic=false, Mythic=false, Secret=false}

-- [[ FITUR 1: INSTANT FISHING ]]
local function StartAutoFish(val)
    _G.FishIt = val
    spawn(function()
        while _G.FishIt do
            task.wait(0.2)
            pcall(function()
                local char = LP.Character
                local rod = char:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
                
                if rod then
                    -- Auto Equip
                    if rod.Parent ~= char then char.Humanoid:EquipTool(rod) end
                    
                    -- Cast: Menggunakan Remote RF/Charge dan RE/BaitCast
                    NetRF.ChargeFishingRod:InvokeServer(100)
                    NetRE.BaitCastVisual:FireServer(Vector3.new(0, -10, 0))
                    
                    -- Instant Catch: Menembak Remote RE/FishCaught
                    task.wait(0.3)
                    NetRE.FishCaught:FireServer(true)
                    NetRE.FishingCompleted:FireServer()
                end
            end)
        end
    end)
end

-- [[ FITUR 2: AUTO FAVORITE ]]
NetRE.ObtainedNewFishNotification.OnClientEvent:Connect(function(fish)
    if fish and activeFavs[fish.Rarity] then
        -- Gunakan ID atau Nama dari data ikan untuk favorite
        NetRE.FavoriteItem:FireServer(fish.Id or fish.Name)
    end
end)

-- UI Toggles
local function MakeToggle(name, pos, cb)
    local b = Instance.new("TextButton", MainFrame)
    b.Size = UDim2.new(0, 260, 0, 40); b.Position = pos
    b.Text = name .. ": OFF"
    local s = false
    b.MouseButton1Click:Connect(function()
        s = not s
        b.Text = name .. ": " .. (s and "ON" or "OFF")
        b.BackgroundColor3 = s and Color3.new(0, 0.5, 0) or Color3.new(0.2, 0.2, 0.2)
        cb(s)
    end)
end

MakeToggle("Instant Auto Fish", UDim2.new(0, 20, 0, 50), StartAutoFish)

-- Dropdown Rarity
local OpenList = Instance.new("TextButton", MainFrame)
OpenList.Text = "▼ SELECT FAVORITE LIST"; OpenList.Size = UDim2.new(0, 260, 0, 40); OpenList.Position = UDim2.new(0, 20, 0, 100)

local FavFrame = Instance.new("ScrollingFrame", MainFrame)
FavFrame.Size = UDim2.new(0, 260, 0, 160); FavFrame.Position = UDim2.new(0, 20, 0, 145)
FavFrame.Visible = false
FavFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

local rarities = {"Common", "Uncommon", "Rare", "Epic", "Mythic", "Secret"}
for i, r in pairs(rarities) do
    local rb = Instance.new("TextButton", FavFrame)
    rb.Size = UDim2.new(1, 0, 0, 25); rb.Position = UDim2.new(0, 0, 0, (i-1)*26)
    rb.Text = r .. ": OFF"
    rb.MouseButton1Click:Connect(function()
        activeFavs[r] = not activeFavs[r]
        rb.Text = r .. (activeFavs[r] and ": ON" or ": OFF")
        rb.BackgroundColor3 = activeFavs[r] and Color3.new(0, 0.4, 0.7) or Color3.new(0.1, 0.1, 0.1)
    end)
end
OpenList.MouseButton1Click:Connect(function() FavFrame.Visible = not FavFrame.Visible end)
